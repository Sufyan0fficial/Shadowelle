{{ 'featured-products-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign featured_collection = section.settings.collection
  assign section_id = 'featured-products-' | append: section.id
-%}

<section id="{{ section_id }}" class="featured-products" style="--featured-columns: {{ section.settings.columns }};" {{ section.shopify_attributes }}>
  <div class="featured-products__header page-width">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="featured-products__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.description != blank %}<p class="featured-products__description">{{ section.settings.description | escape }}</p>{% endif %}
    </div>
    {% if section.settings.view_all_label != blank and featured_collection != blank %}
      <a class="featured-products__view-all" href="{{ featured_collection.url }}">{{ section.settings.view_all_label | escape }}</a>
    {% endif %}
  </div>

  <div class="featured-products__carousel-wrap page-width">
    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <button class="featured-products__arrow featured-products__arrow--previous" type="button" data-featured-previous aria-label="Previous featured products">&#8592;</button>
      <div class="featured-products__carousel" data-featured-carousel tabindex="0">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          {%- liquid
            assign current_variant = product.selected_or_first_available_variant
            assign rating = product.metafields.reviews.rating.value | default: section.settings.default_rating
            assign review_count = product.metafields.reviews.rating_count.value | default: section.settings.default_review_count
            assign discount = 0
            if current_variant.compare_at_price > current_variant.price
              assign discount = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
            endif
            assign image_alt = product.featured_image.alt | default: product.title
          -%}
          <article class="featured-product-card" data-featured-card>
            <div class="featured-product-card__media">
              {% if discount > 0 %}<span class="featured-product-card__sale">-{{ discount }}%</span>{% endif %}
              {% if product.featured_image != blank %}
                <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                  {{ product.featured_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 990px) calc(100vw / 5), (min-width: 750px) 32vw, 82vw', loading: 'lazy', alt: image_alt, class: 'featured-product-card__image' }}
                </a>
              {% else %}
                <div class="featured-product-card__empty-media">Add product image</div>
              {% endif %}
            </div>
            <div class="featured-product-card__body">
              <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              <div class="featured-product-card__reviews" aria-label="{{ rating }} out of 5 stars from {{ review_count }} reviews">
                <span aria-hidden="true">★★★★★</span>
                <span>{{ rating }} ({{ review_count }})</span>
              </div>
              <div class="featured-product-card__pricing">
                <span class="featured-product-card__price">{{ current_variant.price | money }}</span>
                {% if current_variant.compare_at_price > current_variant.price %}<s>{{ current_variant.compare_at_price | money }}</s>{% endif %}
              </div>
              <form class="featured-product-card__form" action="{{ routes.cart_add_url }}" method="post" data-featured-cart-form>
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit"{% unless product.available %} disabled{% endunless %}>
                  {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
                </button>
              </form>
            </div>
          </article>
        {% endfor %}
      </div>
      <button class="featured-products__arrow featured-products__arrow--next" type="button" data-featured-next aria-label="Next featured products">&#8594;</button>
    {% else %}
      <div class="featured-products__empty page-width">Select a collection in the theme editor to show featured products.</div>
    {% endif %}
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById({{ section_id | json }});
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const carousel = root.querySelector('[data-featured-carousel]');
    const cards = root.querySelectorAll('[data-featured-card]');
    const scroll = (direction) => {
      const card = cards[0];
      if (!carousel || !card) return;
      const gap = parseFloat(getComputedStyle(carousel).columnGap || '16');
      carousel.scrollBy({ left: direction * (card.getBoundingClientRect().width + gap), behavior: 'smooth' });
    };
    root.querySelector('[data-featured-previous]')?.addEventListener('click', () => scroll(-1));
    root.querySelector('[data-featured-next]')?.addEventListener('click', () => scroll(1));
    root.querySelectorAll('[data-featured-cart-form]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector('button');
        if (!button || button.disabled) return;
        button.disabled = true;
        const originalLabel = button.textContent;
        button.textContent = 'Adding…';
        try {
          const response = await fetch(`${form.action}.js`, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
          if (!response.ok) throw new Error('Unable to add product');
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          if (window.theme && typeof window.theme.openCartDrawer === 'function') {
            window.theme.openCartDrawer();
          } else {
            window.location.href = '{{ routes.cart_url }}';
          }
        } catch (error) {
          form.submit();
        } finally {
          button.disabled = false;
          button.textContent = originalLabel;
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Explore our most popular pieces, selected for everyday style." },
    { "type": "collection", "id": "collection", "label": "Product collection" },
    { "type": "text", "id": "view_all_label", "label": "View-all label", "default": "View all" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "select", "id": "columns", "label": "Desktop cards", "options": [{ "value": "4", "label": "4 cards" }, { "value": "5", "label": "5 cards" }], "default": "5" },
    { "type": "text", "id": "default_rating", "label": "Fallback rating", "default": "4.8" },
    { "type": "text", "id": "default_review_count", "label": "Fallback review count", "default": "120" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
